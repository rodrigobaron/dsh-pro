# Vendored DeepSeek Harness plugin kept only as an implementation reference
# while this project is being built. Remove this entry once it is no longer
# needed — it carries its own .git, so tracking it would embed a second repo.
reference/

# Editor and OS noise
.DS_Store
*.swp

# Dependencies
node_modules/

# Build output. install.sh builds every plugin that declares a build script,
# so these are reproducible and would only add diff noise. Note the exceptions:
# client-ui-file-canvas/lib/index.js is a hand-written host entry, and
# client-ui-layout-wide/lib/ is the fork itself, not generated.
plugins/context/lib/
plugins/git-review/lib/
plugins/archived-sessions/lib/
plugins/browser/lib/
plugins/at-file/lib/
plugins/search/lib/
plugins/notification/lib/
plugins/rewind/lib/
plugins/rewind-picker/lib/
plugins/routines/lib/
plugins/deep-research/lib/

# vision-toolkit: lib/ is bundled from upstream/, and the payload dirs are
# copied out of upstream/ to sit beside it. upstream/ is the committed input.
plugins/vision-toolkit/lib/
plugins/vision-toolkit/assets/
plugins/vision-toolkit/vendor/
plugins/vision-toolkit/runtime/
plugins/vision-toolkit/workers/
plugins/vision-toolkit/patches/
plugins/client-ui-file-canvas/lib/client.js
