{
  "name": "@dsh-pro/updates",
  "description": "Keep every dsh-pro plugin up to date from GitHub Releases: a checksum-verified tarball swapped into the profile, with the previous install kept as a backup.",
  "version": "0.1.0",
  "author": "Rodrigo Baron <baron.rodrigo0@gmail.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/link-harness.mjs && tsc --noEmit",
    "test": "node --test test/version.test.js test/release.test.js test/plan.test.js test/github.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "schemastery": "^3.18.0",
    "tar": "^7.5.22",
    "typescript": "^5.9.2"
  }
}
