{
  "name": "@my-dsh/workflow",
  "description": "A workflow progress tree inline in the transcript: phases, members, live status and durations.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node test/fold.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.2"
  }
}
