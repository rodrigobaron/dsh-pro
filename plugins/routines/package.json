{
  "name": "@my-dsh/routines",
  "description": "Scheduled agent routines: a cron engine resident in the dsh web host that fires real agent sessions, managed from the settings page or the routines tool.",
  "version": "0.1.0",
  "author": "Rodrigo Baron <baron.rodrigo0@gmail.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/link-harness.mjs && tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "schemastery": "^3.18.1",
    "typescript": "^5.9.2"
  }
}
