{
  "name": "@my-dsh/context",
  "description": "Context insight and management: a context dashboard tab and a /context command showing how the agent's context is composed and how it evolves.",
  "version": "0.17.0",
  "author": "bowenliang123",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
