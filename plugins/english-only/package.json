{
  "name": "@my-dsh/english-only",
  "description": "Pins the interface to English and removes the language selector, so no plugin's non-English dictionary is ever selected.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "src/client.js", "build.mjs"],
  "scripts": { "build": "node build.mjs" },
  "dsh": { "client": { "inject": ["@deepseek-ai/dsh-client-runtime"], "platform": "web" } },
  "license": "MIT",
  "peerDependencies": { "react": "^18.2.0" }
}
